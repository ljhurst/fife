{
    "name": "fife",
    "description": "Finance for Everyone",
    "author": "Luke Hurst <hurstlj@umich.edu>",
    "type": "module",
    "version": "0.16.0",
    "scripts": {
        "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,astro}\" \"test/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,astro}\" \"test/**/*.ts\"",
        "lint": "eslint \"src/**/*.{js,jsx,ts,tsx,astro}\" \"test/**/*.ts\"",
        "lint:fix": "npm run lint -- --fix",
        "check": "npx tsc --noEmit",
        "test": "vitest --run --coverage",
        "test:watch": "vitest --coverage",
        "preflight": "npm run format:check && npm run lint && npm run check && npm run test",
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro"
    },
    "dependencies": {
        "@astrojs/alpinejs": "^0.5.0",
        "@fortawesome/fontawesome-free": "^6.7.2",
        "@types/alpinejs": "^3.17.0",
        "alpinejs": "^3.17.4",
        "astro": "^5.18.2",
        "bulma": "^1.0.4",
        "oidc-client-ts": "^3.5.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^22.20.5",
        "@vitest/coverage-v8": "^3.2.7",
        "astro-eslint-parser": "^1.4.0",
        "csslint": "^1.0.5",
        "eslint": "^9.24.0",
        "eslint-plugin-astro": "^1.7.0",
        "eslint-plugin-import": "^2.32.0",
        "jsdom": "^26.1.0",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^0.14.1",
        "typescript-eslint": "^8.71.2",
        "vitest": "^3.1.1"
    }
}
